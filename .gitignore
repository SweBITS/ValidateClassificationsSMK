# ============================================================================ #
# ValidateClassificationsSMK (v2) — Git Ignore Rules
# ============================================================================ #

# Snakemake state, Conda environments, and SLURM runtime metadata
.snakemake/
slurm-*.out

# Pipeline outputs, logs, and benchmarks
results/
output/
logs/
benchmarks/

# Archived v1 runs and investigations
archive/

# External input files and links (keep input/.gitkeep)
input/*
!input/.gitkeep

# Python & IDE caches
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
.DS_Store