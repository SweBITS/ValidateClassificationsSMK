<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ValidateClassificationsSMK (v2) — eDNA Taxonomic Validation Report</title>
  <style>
    :root {
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --text-main: #0f172a;
      --text-muted: #475569;
      --border: #e2e8f0;
      --accent: #059669;

      /* VALIDATED types: shades of green */
      --clean-bg: #d1fae5;
      --clean-fg: #064e3b;
      --clean-border: #047857;

      --pruned-bg: #ecfdf5;
      --pruned-fg: #047857;
      --pruned-border: #10b981;

      /* FAILED types: both use the same red color */
      --failed-occupancy-bg: #fee2e2;
      --failed-occupancy-fg: #991b1b;
      --failed-occupancy-border: #dc2626;

      --failed-corr-bg: #fee2e2;
      --failed-corr-fg: #991b1b;
      --failed-corr-border: #dc2626;

      /* EXCLUDED / Missing data: shades of gray */
      --excluded-bg: #f1f5f9;
      --excluded-fg: #475569;
      --excluded-border: #cbd5e1;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      line-height: 1.5;
    }
    header {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      padding: 2rem 2.5rem;
      border-bottom: 4px solid #059669;
    }
    header h1 {
      margin: 0 0 0.4rem 0;
      font-size: 1.65rem;
      letter-spacing: -0.02em;
    }
    header p {
      margin: 0;
      color: #cbd5e1;
      font-size: 0.95rem;
    }
    .meta-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-top: 1rem;
      padding-top: 0.85rem;
      border-top: 1px solid rgba(255,255,255,0.14);
      font-size: 0.82rem;
      color: #94a3b8;
    }
    .meta-bar strong { color: #e2e8f0; }
    .container {
      max-width: 1520px;
      margin: 0 auto;
      padding: 1.75rem 2rem 3rem 2rem;
    }

    /* KPI Cards with Tooltips */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.15rem 1.35rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      position: relative;
      cursor: help;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    .kpi-card:hover {
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      transform: translateY(-1px);
    }
    .kpi-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      font-weight: 600;
    }
    .kpi-value {
      font-size: 2rem;
      font-weight: 700;
      margin: 0.2rem 0;
    }
    .kpi-sub { font-size: 0.82rem; color: var(--text-muted); }

    /* Floating Global Tooltip (immune to container and overflow clipping) */
    .global-tooltip {
      position: fixed;
      display: none;
      background: #0f172a;
      color: #ffffff;
      border: 1px solid #ffffff;
      padding: 0.5rem 0.85rem;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 400;
      line-height: 1.35;
      max-width: 320px;
      z-index: 999999;
      pointer-events: none;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
      text-align: center;
      word-wrap: break-word;
      transition: opacity 0.12s ease;
      opacity: 0;
    }
    .global-tooltip.visible {
      display: block;
      opacity: 1;
    }

    /* Section Cards */
    .section-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.4rem 1.5rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .section-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .section-title {
      margin: 0;
      font-size: 1.18rem;
      font-weight: 700;
    }

    /* Glossary Section */
    .glossary-card {
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 10px;
      margin-bottom: 1.75rem;
      overflow: hidden;
    }
    .glossary-summary {
      padding: 0.9rem 1.35rem;
      background: #f8fafc;
      font-weight: 600;
      font-size: 0.92rem;
      color: #1e293b;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      user-select: none;
    }
    .glossary-summary:hover {
      background: #f1f5f9;
    }
    .glossary-body {
      padding: 1.25rem 1.35rem;
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1rem;
      font-size: 0.84rem;
    }
    .glossary-item {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 0.75rem 0.9rem;
      background: #f8fafc;
      border-radius: 8px;
      border-left: 4px solid #cbd5e1;
    }
    .glossary-item.clean { border-left-color: var(--clean-border); }
    .glossary-item.pruned { border-left-color: var(--pruned-border); }
    .glossary-item.occupancy { border-left-color: var(--failed-occupancy-border); }
    .glossary-item.correlation { border-left-color: var(--failed-corr-border); }
    .glossary-item.excluded { border-left-color: var(--excluded-border); }
    .glossary-item-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
    }

    /* Controls Bar */
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }
    .search-input {
      padding: 0.45rem 0.75rem;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 0.88rem;
      min-width: 240px;
    }
    .filter-btn {
      padding: 0.42rem 0.8rem;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      color: #334155;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .filter-btn:hover { background: #e2e8f0; }
    .filter-btn.active {
      background: #0f172a;
      color: #ffffff;
      border-color: #0f172a;
    }
    .reset-btn {
      padding: 0.42rem 0.8rem;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      color: #475569;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .reset-btn:hover {
      background: #f1f5f9;
      color: #0f172a;
      border-color: #94a3b8;
    }

    /* Column Visibility Dropdown */
    .dropdown {
      position: relative;
      display: inline-block;
    }
    .dropdown-btn {
      padding: 0.42rem 0.8rem;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      color: #334155;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.15s;
    }
    .dropdown-btn:hover { background: #f8fafc; border-color: #94a3b8; }
    .dropdown-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      margin-top: 0.35rem;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
      padding: 0.75rem 0.9rem;
      z-index: 100;
      min-width: 240px;
      max-height: 400px;
      overflow-y: auto;
    }
    .dropdown-menu.show { display: block; }
    .col-item {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.8rem;
      padding: 0.3rem 0;
      cursor: pointer;
      user-select: none;
    }
    .col-item input { cursor: pointer; }

    /* Table Styles */
    .table-wrap { overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
    }
    th, td {
      padding: 0.6rem 0.7rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    th {
      background: #f8fafc;
      font-weight: 600;
      color: #334155;
      cursor: pointer;
      user-select: none;
      transition: background 0.15s;
    }
    th:hover { background: #e2e8f0; }
    th .sort-icon {
      margin-left: 0.35rem;
      font-size: 0.72rem;
      color: #94a3b8;
    }
    tr:hover td { background-color: #f8fafc; }
    .num { text-align: right; font-variant-numeric: tabular-nums; }

    /* Status Badges / Pills */
    .badge {
      display: inline-block;
      padding: 0.22rem 0.6rem;
      border-radius: 999px;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      cursor: help;
      text-decoration: none;
    }
    .badge-VALIDATED_CLEAN {
      background: var(--clean-bg);
      color: var(--clean-fg);
      border: 1px solid var(--clean-border);
    }
    .badge-VALIDATED_PRUNED {
      background: var(--pruned-bg);
      color: var(--pruned-fg);
      border: 1px solid var(--pruned-border);
    }
    .badge-FAILED_LOW_OCCUPANCY {
      background: var(--failed-occupancy-bg);
      color: var(--failed-occupancy-fg);
      border: 1px solid var(--failed-occupancy-border);
    }
    .badge-FAILED_LOW_CORRELATION {
      background: var(--failed-corr-bg);
      color: var(--failed-corr-fg);
      border: 1px solid var(--failed-corr-border);
    }
    .badge-EXCLUDED {
      background: var(--excluded-bg);
      color: var(--excluded-fg);
      border: 1px solid var(--excluded-border);
    }

    /* Species Cards */
    .species-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      margin-bottom: 1.5rem;
      overflow: hidden;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .species-card-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.4rem;
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
    }
    .species-card-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin: 0;
    }
    .species-card-body { padding: 1.25rem 1.4rem; }
    .reason-banner {
      padding: 0.65rem 0.95rem;
      background: #f1f5f9;
      border-left: 4px solid #059669;
      border-radius: 4px;
      font-size: 0.88rem;
      margin-bottom: 1rem;
      color: #1e293b;
    }
    .metrics-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.15rem;
    }
    .metric-box {
      padding: 0.6rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: #fafafa;
    }
    .metric-box .m-lbl { font-size: 0.73rem; color: var(--text-muted); text-transform: uppercase; }
    .metric-box .m-val { font-size: 0.98rem; font-weight: 700; margin-top: 0.15rem; }
    .diagnostic-img {
      width: 100%;
      height: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
      display: block;
      cursor: zoom-in;
      transition: box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .diagnostic-img:hover {
      border-color: #94a3b8;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.10);
    }

    /* Full-Screen Figure Lightbox Modal */
    .lightbox-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1000000;
      background: rgba(15, 23, 42, 0.95);
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .lightbox-overlay.active {
      display: flex;
    }
    .lightbox-toolbar {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.65rem 1.25rem;
      background: rgba(15, 23, 42, 0.98);
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      color: #f8fafc;
      font-size: 0.9rem;
      flex-shrink: 0;
    }
    .lightbox-title {
      font-weight: 600;
      color: #e2e8f0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .lightbox-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .lightbox-btn {
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: 6px;
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    .lightbox-btn:hover {
      background: rgba(255, 255, 255, 0.24);
    }
    .lightbox-stage {
      flex: 1;
      width: 100%;
      overflow: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem;
    }
    .lightbox-stage.zoomed {
      align-items: flex-start;
      justify-content: flex-start;
    }
    .lightbox-img {
      max-width: 98vw;
      max-height: calc(100vh - 64px);
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 6px;
      background: #ffffff;
      cursor: zoom-in;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }
    .lightbox-stage.zoomed .lightbox-img {
      max-width: none;
      max-height: none;
      width: 165vw;
      cursor: zoom-out;
    }
    details.pruned-details {
      margin-top: 0.9rem;
      font-size: 0.84rem;
    }
    details.pruned-details summary {
      cursor: pointer;
      font-weight: 600;
      color: #059669;
    }
    a.jump-link {
      color: #059669;
      text-decoration: none;
      font-weight: 600;
    }
    a.jump-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  {% set status_tooltips = {
    'VALIDATED_CLEAN': 'Validated Clean: Initial Pearson R >= 0.90 with positive slope across all 100 bins without any pruning. Validates uniform genome-wide eDNA coverage.',
    'VALIDATED_PRUNED': 'Validated Pruned: Confirmed true positive after pruning 1 or more outlier bins (e.g. rDNA/repeats) while retaining >= 50% CR sequence (Final Pearson R >= 0.90, slope > 0).',
    'FAILED_LOW_OCCUPANCY': 'Failed Low Occupancy: Pre-regression gate failed. Less than 50% of bins contain mapped read pairs or initial slope is non-positive (reads clustered in isolated spikes).',
    'FAILED_LOW_CORRELATION': 'Failed Low Correlation: Reached the 50% CR sequence retention floor without attaining Pearson R >= 0.90 with a positive slope.',
    'EXCLUDED_LOW_READ_COUNT': 'Excluded Low Read Count: Total clade reads across 516 weeks fell below the minimum statistical power cutoff (< 1,000 reads).',
    'EXCLUDED_ORGANELLAR_ONLY': 'Excluded Organellar Only: Clade represented solely by mitochondrial or plastid sequences in database manifest; no nuclear reference assembly.',
    'EXCLUDED_NCBI_UNAVAILABLE': 'Excluded NCBI Unavailable: All candidate nuclear assemblies for this clade are suppressed, withdrawn, or retired from live NCBI Datasets.',
    'EXCLUDED_INSUFFICIENT_CONTIG_LENGTH': 'Excluded Short Contigs: Retaining contigs >= 1 kb left less than 100 kb of total sequence.',
    'EXCLUDED_FILTERED_ASSEMBLY_PROPORTION': 'Excluded High Discard: Removing contigs < 1 kb discarded more than 50% of the total assembly sequence.',
    'EXCLUDED_INSUFFICIENT_CR_LENGTH': 'Excluded Short CR: Total Classifiable Region length is insufficient to form 100 bins.',
    'EXCLUDED_NO_ASSEMBLY_IN_DB': 'Excluded No Assembly: No reference genome found in the database manifest for this clade.',
    'EXCLUDED_TAXID_NOT_FOUND': 'Excluded TaxID: Target taxon not found in the JolTax taxonomy tree.'
  } %}

  <header>
    <h1>ValidateClassificationsSMK (v2) — High-Throughput eDNA Taxonomic Validation Report</h1>
    <p>SweBITS Project, Umeå University &middot; 10-Year Ljungbyhed Weekly Air-Filter Metagenomic Time Series (516 Samples, 2013–2022)</p>
    <div class="meta-bar">
      <div><strong>Active Coverage Tier:</strong> {{ config.get('coverage_tier', '2x') }} ({{ config.get('tile_window_bp', 400) }} bp window)</div>
      <div><strong>Kraken 2 Thresholds:</strong> conf={{ config.get('kraken2_confidence', 0.1) }}, MHG={{ config.get('kraken2_minimum_hit_groups', 10) }}</div>
      <div><strong>Validation Cutoffs:</strong> R &ge; {{ config.get('target_r', 0.90) }}, Occupancy &ge; {{ (config.get('min_occupied_bins_frac', 0.50) * 100)|int }}%, Retained CR &ge; {{ (config.get('min_retained_cr_frac', 0.50) * 100)|int }}%</div>
      <div><strong>Git Branch / Commit:</strong> {{ wf_info.get('git_branch', 'N/A') }} ({{ wf_info.get('git_commit', 'N/A') }})</div>
      <div><strong>Generated:</strong> {{ wf_info.get('end_timestamp', 'N/A') }}</div>
    </div>
  </header>

  <div class="container">
    <!-- Executive Summary KPI Cards with Tooltips -->
    <div class="kpi-grid">
      <div class="kpi-card" data-tooltip="All target species specified in config/targets.tsv evaluated against the 10-year Ljungbyhed monitoring series.">
        <div class="kpi-label">Total Target Taxa</div>
        <div class="kpi-value">{{ kpi.total_targets }}</div>
        <div class="kpi-sub">Tracked in config/targets.tsv</div>
      </div>
      <div class="kpi-card" data-tooltip="Taxa meeting both the occupancy gate (>= 50% bins) and correlation threshold (Pearson R >= 0.90) with positive slope.">
        <div class="kpi-label">Total Validated (R &ge; {{ config.get('target_r', 0.90) }})</div>
        <div class="kpi-value" style="color: #059669;">{{ kpi.validated_total }}</div>
        <div class="kpi-sub">{{ kpi.validated_clean }} Clean + {{ kpi.validated_pruned }} Pruned</div>
      </div>
      <div class="kpi-card" data-tooltip="Genuine eDNA detections where mapped reads distribute linearly across all 100 CR bins without removing any genomic bins.">
        <div class="kpi-label">Validated Clean (0 Bins Pruned)</div>
        <div class="kpi-value" style="color: #047857;">{{ kpi.validated_clean }}</div>
        <div class="kpi-sub">Initial R &ge; {{ config.get('target_r', 0.90) }} across all 100 bins</div>
      </div>
      <div class="kpi-card" data-tooltip="Confirmed eDNA detections validated after excising 1 or more outlier bins (e.g. rDNA/repeats/artifacts) while retaining >= 50% CR length.">
        <div class="kpi-label">Validated After Outlier Pruning</div>
        <div class="kpi-value" style="color: #10b981;">{{ kpi.validated_pruned }}</div>
        <div class="kpi-sub">Reached R &ge; {{ config.get('target_r', 0.90) }} retaining &ge; 50% CR</div>
      </div>
      <div class="kpi-card" data-tooltip="Taxa failing either Stage 5 regression gates (low occupancy or low correlation) or excluded during pre-flight checks.">
        <div class="kpi-label">Failed / Excluded</div>
        <div class="kpi-value" style="color: #dc2626;">{{ kpi.failed_total }} / {{ kpi.excluded_total }}</div>
        <div class="kpi-sub">{{ kpi.failed_total }} Failed Regression &middot; {{ kpi.excluded_total }} Pre-Flight Excluded</div>
      </div>
    </div>

    <!-- Validation Status Reference & Code Glossary -->
    <details class="glossary-card">
      <summary class="glossary-summary">
        <span>📖 Validation Status Codes Reference &amp; Methodology Guide (Click to Expand / Collapse)</span>
        <span style="font-size:0.8rem; color:#64748b;">Help on status codes</span>
      </summary>
      <div class="glossary-body">
        <div class="glossary-item clean">
          <div class="glossary-item-title">
            <span class="badge badge-VALIDATED_CLEAN">VALIDATED_CLEAN</span>
            <span style="color:#064e3b; font-size:0.75rem; font-weight:600;">(Deep Green)</span>
          </div>
          <div><strong>Uniform genome-wide signal:</strong> Mapped eDNA reads track Classifiable Region length with initial Pearson <i>R</i> &ge; 0.90 and strictly positive slope (&beta;<sub>1</sub> &gt; 0) across all 100 bins with zero bins pruned. Confirms an authentic biological detection.</div>
        </div>
        <div class="glossary-item pruned">
          <div class="glossary-item-title">
            <span class="badge badge-VALIDATED_PRUNED">VALIDATED_PRUNED</span>
            <span style="color:#047857; font-size:0.75rem; font-weight:600;">(Lighter Green)</span>
          </div>
          <div><strong>Pruned biological validation:</strong> Reached <i>R</i> &ge; 0.90 and &beta;<sub>1</sub> &gt; 0 after iteratively pruning &ge; 1 outlier bins (e.g. high-copy ribosomal arrays, mobile elements, or assembly contaminants) while retaining &ge; 50% of the total Classifiable Region sequence length.</div>
        </div>
        <div class="glossary-item occupancy">
          <div class="glossary-item-title">
            <span class="badge badge-FAILED_LOW_OCCUPANCY">FAILED_LOW_OCCUPANCY</span>
            <span style="color:#991b1b; font-size:0.75rem; font-weight:600;">(Red)</span>
          </div>
          <div><strong>Pre-regression occupancy gate failed:</strong> Less than 50% of the 100 bins contain &ge; 1 mapped read pair, or the initial slope is non-positive (&beta;<sub>1</sub> &le; 0). Characteristic of false-positive detections where reads pile into a few conserved locus spikes while the rest of the genome is empty.</div>
        </div>
        <div class="glossary-item correlation">
          <div class="glossary-item-title">
            <span class="badge badge-FAILED_LOW_CORRELATION">FAILED_LOW_CORRELATION</span>
            <span style="color:#991b1b; font-size:0.75rem; font-weight:600;">(Red)</span>
          </div>
          <div><strong>Correlation threshold not attained:</strong> Pruning reached the 50% CR sequence retention floor without reaching Pearson <i>R</i> &ge; 0.90 with a positive slope. The reads do not correlate linearly with classifiable genomic sequence.</div>
        </div>
        <div class="glossary-item excluded">
          <div class="glossary-item-title">
            <span class="badge badge-EXCLUDED">EXCLUDED_LOW_READ_COUNT</span>
            <span style="color:#475569;">(Gray)</span>
          </div>
          <div><strong>Pre-flight statistical gate:</strong> Total clade reads across all 516 weekly samples was below the minimum cutoff (&lt; 1,000 reads), providing insufficient statistical power to populate 100 bins.</div>
        </div>
        <div class="glossary-item excluded">
          <div class="glossary-item-title">
            <span class="badge badge-EXCLUDED">EXCLUDED_ORGANELLAR_ONLY</span>
            <span style="color:#475569;">(Gray)</span>
          </div>
          <div><strong>Organellar reference only:</strong> The clade is represented solely by mitochondrial or plastid sequences in the Kraken 2 database manifest, with no nuclear reference assembly available.</div>
        </div>
        <div class="glossary-item excluded">
          <div class="glossary-item-title">
            <span class="badge badge-EXCLUDED">EXCLUDED_NCBI_UNAVAILABLE</span>
            <span style="color:#475569;">(Gray)</span>
          </div>
          <div><strong>Assembly withdrawn/suppressed:</strong> All candidate nuclear assemblies in the database manifest for this clade have been suppressed or retired on live NCBI Datasets.</div>
        </div>
        <div class="glossary-item excluded">
          <div class="glossary-item-title">
            <span class="badge badge-EXCLUDED">EXCLUDED_FILTER_GATES</span>
            <span style="color:#475569;">(Gray)</span>
          </div>
          <div><strong>Assembly contig length gate:</strong> The draft assembly has insufficient contig length (discarding &lt; 1 kb contigs left &lt; 100 kb sequence or discarded &gt; 50% of the assembly).</div>
        </div>
      </div>
    </details>

    <!-- Diagnostic Dashboard Panel Reference Guide -->
    <details class="glossary-card">
      <summary class="glossary-summary">
        <span>📊 Diagnostic Dashboard Panel Guide — Widescreen (Panels A–J) &amp; Compact 2&times;2 Figures (Click to Expand / Collapse)</span>
        <span style="font-size:0.8rem; color:#64748b;">How to read each panel</span>
      </summary>
      <div class="glossary-body">
        <div class="glossary-item clean">
          <div class="glossary-item-title"><strong>Panel A &mdash; Bin CR Length vs. Mapped Reads (+ Top Structural Strip)</strong></div>
          <div>Regresses mapped eDNA read pairs (<i>Y</i>) against Classifiable Region length (<i>X</i>, across 100 linear-capacity bins) with intra-bin <code>p25–p75</code> coverage whiskers and a slim top strip showing distinct contigs per bin and median CR length (kb). Colored by <strong>516w Temporal Cosine Similarity</strong> (horizontal colorbar shared between Panels A &amp; C).</div>
        </div>
        <div class="glossary-item pruned">
          <div class="glossary-item-title"><strong>Panel B &mdash; Recursive Outlier Pruning Trajectory</strong></div>
          <div>Tracks Pearson correlation <i>R</i> (blue) and Retained CR sequence % (orange) across iterative outlier bin pruning steps against the validation thresholds (<i>R</i> &ge; 0.90, Retained CR &ge; 50%).</div>
        </div>
        <div class="glossary-item clean">
          <div class="glossary-item-title"><strong>Panel C &mdash; Genome-Wide CR Manhattan Plot</strong></div>
          <div>Plots read density (<code>Reads / kb</code>) for every CR segment along cumulative CR coordinates (<code>bin_001 &rarr; bin_100</code>) on a <code>symlog(linthresh=1.0)</code> scale (slate band = linear <code>0 &le; y &le; 1</code>; log<sub>10</sub> above <code>y = 1</code>), colored by 516w Cosine Similarity with rose vertical bands marking pruned bins.</div>
        </div>
        <div class="glossary-item occupancy">
          <div class="glossary-item-title"><strong>Panel D &mdash; Outlier Quadrant (Size = Intra-Bin Length-Weighted Gini)</strong></div>
          <div>Plots Excess Depth (<code>log<sub>2</sub>(Observed / Length-Proportional Clean Expected Reads)</code>) vs. 516w Cosine Similarity to separate <strong>Endogenous Multi-Copy Repeats</strong> (high depth, high cosine similarity) from <strong>Foreign Cross-Mapping Artifacts</strong> (high depth, low cosine similarity). Marker size encodes the <strong>Intra-Bin Length-Weighted Gini Coefficient (<i>G<sub>b</sub></i> &in; [0, 1])</strong>.</div>
        </div>
        <div class="glossary-item pruned">
          <div class="glossary-item-title"><strong>Panels E1, E2 &amp; E3 &mdash; Read Attrition, % Identity Spectrum &amp; Genomic CR Funnel</strong></div>
          <div><strong>E1:</strong> 5-stage read attrition funnel (Raw Kraken &rarr; MAPQ &ge; 30 &rarr; &ge;80% Aligned &rarr; &ge;99% Identity &rarr; Clean Bins). <strong>E2:</strong> 1%-bin sequence identity spectrum (<code>[90–100%]</code>). <strong>E3 (under E2):</strong> 3-stage genomic sequence funnel (<code>1. Total Assembly Size &rarr; 2. Total CR Size &rarr; 3. Pruned CR Size (Clean)</code>).</div>
        </div>
        <div class="glossary-item clean">
          <div class="glossary-item-title"><strong>Panels F, G &amp; H &mdash; 1:1 Weekly Correlation, 516-Week Series &amp; Seasonal Phenology</strong></div>
          <div><strong>F:</strong> Weekly raw vs. clean-bin pairs on <code>log<sub>10</sub>(Reads+1)</code> axes (reporting linear <i>R</i>, <i>R</i><sub>log</sub>, and Spearman &rho;). <strong>G:</strong> 10-year (516-week) longitudinal time series stacked below Panel C. <strong>H:</strong> 3-week circular-smoothed seasonal phenology across Jan–Dec with dual Y-axes (<code>% of annual signal</code> and <code>Mean Clean Pairs / Week</code>).</div>
        </div>
        <div class="glossary-item excluded">
          <div class="glossary-item-title"><strong>Panel I &mdash; Bin Temporal Sample Occupancy (% of 516 Weeks Occupied)</strong></div>
          <div>Plots each bin's Sample Occupancy (<code>% of 516 weekly samples with &ge;1 read pair</code>) vs. 516w Cosine Similarity, with a top marginal occupancy histogram, Clean Median Occupancy, and Effective Active Weeks (<i>N</i><sub>eff</sub> = 1/&sum;<i>p<sub>t</sub></i><sup>2</sup>).</div>
        </div>
        <div class="glossary-item clean">
          <div class="glossary-item-title"><strong>Panel J &mdash; Hierarchical Clustermap (100 Bins &times; Active Monitoring Weeks)</strong></div>
          <div>Clusters all 100 bins on <code>log<sub>10</sub>(Reads/kb + 1)</code> using Ward minimum-variance linkage (<code>method="ward"</code>, <code>metric="euclidean"</code>, <code>optimal_ordering=True</code>), with 3 vertical annotation strips (<code>CosSim</code>, <code>Occ%</code>, <code>Pruned</code>) and 2 slim horizontal colorbars (<code>Occ% Strip</code> and <code>Bin Read Density</code>).</div>
        </div>
      </div>
    </details>

    <!-- Master Validation Summary Table -->
    <div class="section-card">
      <div class="section-header">
        <h2 class="section-title">Master Validation Summary Ledger (All Target Taxa)</h2>
        <div class="controls">
          <input type="text" id="speciesSearch" class="search-input" placeholder="Search species, TaxID, accession, or status..." oninput="filterTable()" />
          <button class="filter-btn active" onclick="setGroupFilter('ALL', this)">All ({{ kpi.total_targets }})</button>
          <button class="filter-btn" onclick="setGroupFilter('VALIDATED', this)">Validated ({{ kpi.validated_total }})</button>
          <button class="filter-btn" onclick="setGroupFilter('FAILED', this)">Failed ({{ kpi.failed_total }})</button>
          <button class="filter-btn" onclick="setGroupFilter('EXCLUDED', this)">Excluded ({{ kpi.excluded_total }})</button>
          
          <!-- Column Visibility Dropdown -->
          <div class="dropdown">
            <button class="dropdown-btn" onclick="toggleDropdown(event)">Columns ▾</button>
            <div id="colDropdown" class="dropdown-menu">
              <div style="font-weight:700; margin-bottom:0.4rem; padding-bottom:0.3rem; border-bottom:1px solid #e2e8f0; font-size:0.8rem;">Toggle Columns</div>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="0" checked onchange="toggleColumn(0, this.checked)"> TaxID</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="1" checked onchange="toggleColumn(1, this.checked)"> Species</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="2" checked onchange="toggleColumn(2, this.checked)"> Status</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="3" checked onchange="toggleColumn(3, this.checked)"> Clade Reads</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="4" checked onchange="toggleColumn(4, this.checked)"> Chosen Assembly</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="5" checked onchange="toggleColumn(5, this.checked)"> Level</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="6" checked onchange="toggleColumn(6, this.checked)"> Kept Assembly (bp)</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="7" checked onchange="toggleColumn(7, this.checked)"> Discarded bp %</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="8" checked onchange="toggleColumn(8, this.checked)"> 2x CR (bp)</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="9" checked onchange="toggleColumn(9, this.checked)"> 2x CR %</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="10" checked onchange="toggleColumn(10, this.checked)"> Occupied Bins</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="11" checked onchange="toggleColumn(11, this.checked)"> Initial R</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="12" checked onchange="toggleColumn(12, this.checked)"> Final R</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="13" checked onchange="toggleColumn(13, this.checked)"> Final &rho;</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="14" checked onchange="toggleColumn(14, this.checked)"> Bins Pruned</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="15" checked onchange="toggleColumn(15, this.checked)"> Retained CR %</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="16" checked onchange="toggleColumn(16, this.checked)"> Retained Reads %</label>
              <label class="col-item"><input type="checkbox" class="col-toggle-checkbox" value="17" checked onchange="toggleColumn(17, this.checked)"> Status Reason</label>
            </div>
          </div>

          <!-- Reset Button -->
          <button class="reset-btn" onclick="resetTable()">↺ Reset</button>
        </div>
      </div>
      <div class="table-wrap">
        <table id="masterTable">
          <thead>
            <tr>
              <th onclick="sortTable(0)">TaxID <span class="sort-icon">⇅</span></th>
              <th onclick="sortTable(1)">Species <span class="sort-icon">⇅</span></th>
              <th onclick="sortTable(2)">Status <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(3)">Clade Reads <span class="sort-icon">⇅</span></th>
              <th onclick="sortTable(4)">Chosen Assembly <span class="sort-icon">⇅</span></th>
              <th onclick="sortTable(5)">Level <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(6)">Kept Assembly (bp) <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(7)">Discarded bp % <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(8)">2x CR (bp) <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(9)">2x CR % <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(10)">Occupied Bins <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(11)">Initial R <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(12)">Final R <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(13)">Final &rho; <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(14)">Bins Pruned <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(15)">Retained CR % <span class="sort-icon">⇅</span></th>
              <th class="num" onclick="sortTable(16)">Retained Reads % <span class="sort-icon">⇅</span></th>
              <th onclick="sortTable(17)">Status Reason <span class="sort-icon">⇅</span></th>
            </tr>
          </thead>
          <tbody>
            {% for sp in species_cards %}
            <tr data-group="{{ sp.status_group }}">
              <td><a class="jump-link" href="#species-{{ sp.t_id }}">{{ sp.t_id }}</a></td>
              <td><a class="jump-link" href="#species-{{ sp.t_id }}"><em>{{ sp.scientific_name }}</em></a>{% if sp.common_name %} <span style="color:#64748b;">({{ sp.common_name }})</span>{% endif %}</td>
              <td>
                {% set badge_cls = sp.validation_status if sp.validation_status.startswith('VALIDATED') or sp.validation_status.startswith('FAILED') else 'EXCLUDED' %}
                <span class="badge badge-{{ badge_cls }}" data-tooltip="{{ status_tooltips.get(sp.validation_status, 'Validation status: ' ~ sp.validation_status) }}">{{ sp.validation_status }}</span>
              </td>
              <td class="num">{{ "{:,}".format(sp.total_clade_reads) }}</td>
              <td><code>{{ sp.chosen_accession }}</code></td>
              <td>{{ sp.chosen_level }}</td>
              <td class="num">{{ "{:,}".format(sp.kept_assembly_bp) }}</td>
              <td class="num">{{ "%.2f"|format(sp.discarded_bp_pct) }}%</td>
              <td class="num">{{ "{:,}".format(sp.cr_bp_2x) }}</td>
              <td class="num">{{ "%.2f"|format(sp.cr_pct_of_filtered_assembly_2x) }}%</td>
              <td class="num">{{ sp.occupied_bins }}/{{ sp.n_bins }}</td>
              <td class="num">{{ "%.4f"|format(sp.initial_pearson_r) }}</td>
              <td class="num"><strong>{{ "%.4f"|format(sp.final_pearson_r) }}</strong></td>
              <td class="num">{{ "%.4f"|format(sp.final_spearman_rho) }}</td>
              <td class="num">{{ sp.bins_pruned_count }}</td>
              <td class="num">{{ "%.1f"|format(sp.retained_cr_pct) }}%</td>
              <td class="num">{{ "%.1f"|format(sp.retained_mapped_reads_pct) }}%</td>
              <td style="white-space: normal; min-width: 280px; color: #334155;">{{ sp.status_reason }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Per-Species Diagnostic Cards -->
    <h2 style="margin: 2rem 0 1rem 0; font-size: 1.25rem;">Per-Species Diagnostic Profiles &amp; 10-Year Time Series</h2>
    {% for sp in species_cards %}
    <div class="species-card" id="species-{{ sp.t_id }}" data-group="{{ sp.status_group }}">
      <div class="species-card-header">
        <h3 class="species-card-title">
          <em>{{ sp.scientific_name }}</em>
          {% if sp.common_name %}<span style="font-weight:400; color:#475569;">({{ sp.common_name }})</span>{% endif %}
          &mdash; <span style="font-weight:500; color:#64748b;">TaxID {{ sp.t_id }} &middot; {{ sp.t_phylum or sp.t_domain }} / {{ sp.t_family }}</span>
        </h3>
        {% set badge_cls = sp.validation_status if sp.validation_status.startswith('VALIDATED') or sp.validation_status.startswith('FAILED') else 'EXCLUDED' %}
        <span class="badge badge-{{ badge_cls }}" data-tooltip="{{ status_tooltips.get(sp.validation_status, 'Validation status: ' ~ sp.validation_status) }}">{{ sp.validation_status }}</span>
      </div>
      <div class="species-card-body">
        <div class="reason-banner">
          <strong>Decision Summary:</strong> {{ sp.status_reason }}
        </div>
        <div class="metrics-strip">
          <div class="metric-box">
            <div class="m-lbl">Clade Reads (N Samples)</div>
            <div class="m-val">{{ "{:,}".format(sp.total_clade_reads) }} ({{ sp.weeks_present }}, {{ "%.1f"|format(sp.samples_present_pct) }}%)</div>
          </div>
          <div class="metric-box">
            <div class="m-lbl">Selected Reference</div>
            <div class="m-val">{{ sp.chosen_accession }} ({{ sp.chosen_level }})</div>
          </div>
          <div class="metric-box">
            <div class="m-lbl">N50 / FASTA Entries</div>
            <div class="m-val">{{ "{:,}".format(sp.n50_bp) }} bp ({{ "{:,}".format(sp.kept_contig_count) }} entries)</div>
          </div>
          <div class="metric-box">
            <div class="m-lbl">&ge;1 kb Contig Filter</div>
            <div class="m-val">{{ "{:,}".format(sp.kept_assembly_bp) }} bp ({{ "%.1f"|format(100.0 - sp.discarded_bp_pct) }}% kept)</div>
          </div>
          <div class="metric-box">
            <div class="m-lbl">CR Length (Pre-Pruning)</div>
            <div class="m-val">{{ "{:,}".format(sp.cr_bp_2x) }} bp ({{ "%.1f"|format(sp.cr_pct_of_filtered_assembly_2x) }}%)</div>
          </div>
          <div class="metric-box">
            <div class="m-lbl">Initial &rarr; Final R</div>
            <div class="m-val">{{ "%.3f"|format(sp.initial_pearson_r) }} &rarr; {{ "%.3f"|format(sp.final_pearson_r) }}</div>
          </div>
          <div class="metric-box">
            <div class="m-lbl">Bins Pruned / CR Kept</div>
            <div class="m-val">{{ sp.bins_pruned_count }} bins / {{ "%.1f"|format(sp.retained_cr_pct) }}% CR</div>
          </div>
          <div class="metric-box">
            <div class="m-lbl">Clean-Bin Mapped Pairs</div>
            <div class="m-val">{{ "{:,}".format(sp.retained_mapped_read_pairs) }} ({{ "%.1f"|format(sp.retained_pct_of_clade_reads) }}% clade / {{ "%.1f"|format(sp.retained_mapped_reads_pct) }}% CR)</div>
          </div>
        </div>

        {% if sp.plot_data_uri %}
        <img class="diagnostic-img" src="{{ sp.plot_data_uri }}" alt="Diagnostic plot for {{ sp.scientific_name }} (TaxID {{ sp.t_id }})" title="Click to view full-screen" onclick="openImageLightbox(this)" />
        {% endif %}

        {% if sp.pruned_steps %}
        <details class="pruned-details">
          <summary>View {{ sp.pruned_steps|length }} Pruned Outlier Bin(s) Trajectory Table</summary>
          <div class="table-wrap" style="margin-top:0.5rem;">
            <table>
              <thead>
                <tr>
                  <th>Step</th>
                  <th>Bin Removed</th>
                  <th class="num">Bin CR Length (bp)</th>
                  <th class="num">Reads Removed</th>
                  <th class="num">Vertical Residual</th>
                  <th class="num">Retained CR %</th>
                  <th class="num">Retained Reads %</th>
                  <th class="num">Pearson R After</th>
                  <th class="num">Spearman &rho; After</th>
                </tr>
              </thead>
              <tbody>
                {% for st in sp.pruned_steps %}
                <tr>
                  <td>#{{ st.iteration }}</td>
                  <td><code>{{ st.bin_id_removed }}</code></td>
                  <td class="num">{{ "{:,}".format(st.cr_bp_removed|int) }}</td>
                  <td class="num">{{ "{:,}".format(st.reads_removed|int) }}</td>
                  <td class="num">{{ st.vertical_residual }}</td>
                  <td class="num">{{ st.retained_cr_pct }}%</td>
                  <td class="num">{{ st.retained_reads_pct }}%</td>
                  <td class="num"><strong>{{ st.pearson_r }}</strong></td>
                  <td class="num">{{ st.spearman_rho }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </details>
        {% endif %}
      </div>
    </div>
    {% endfor %}

    <!-- SLURM Benchmark Summary -->
    {% if benchmarks %}
    <div class="section-card">
      <h2 class="section-title" style="margin-bottom:0.85rem;">HPC Stage Resource Benchmark Summary</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Pipeline Stage</th>
              <th class="num">Completed Jobs</th>
              <th class="num">Total Walltime (min)</th>
              <th class="num">Max Job Walltime (min)</th>
              <th class="num">Mean Job Walltime (s)</th>
              <th class="num">Peak RSS Memory (MB)</th>
              <th class="num">Mean RSS Memory (MB)</th>
            </tr>
          </thead>
          <tbody>
            {% for b in benchmarks %}
            <tr>
              <td><code>{{ b.stage }}</code></td>
              <td class="num">{{ b.job_count }}</td>
              <td class="num">{{ b.total_walltime_min }}</td>
              <td class="num">{{ b.max_walltime_min }}</td>
              <td class="num">{{ b.mean_walltime_sec }}</td>
              <td class="num">{{ b.max_rss_mb }}</td>
              <td class="num">{{ b.mean_rss_mb }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}
  </div>

  <div id="globalTooltip" class="global-tooltip" role="tooltip" aria-hidden="true"></div>

  <!-- Full-Screen Figure Lightbox Modal -->
  <div id="imageLightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Full-screen diagnostic figure" onclick="handleLightboxBackdropClick(event)">
    <div class="lightbox-toolbar" onclick="event.stopPropagation()">
      <div id="lightboxTitle" class="lightbox-title">Diagnostic Figure</div>
      <div class="lightbox-actions">
        <button type="button" class="lightbox-btn" id="lightboxZoomBtn" onclick="toggleLightboxZoom()">🔍 Zoom 1:1 / Pan</button>
        <button type="button" class="lightbox-btn" onclick="toggleNativeFullscreen()">⛶ Browser Fullscreen</button>
        <button type="button" class="lightbox-btn" onclick="closeImageLightbox()">✕ Close (Esc)</button>
      </div>
    </div>
    <div id="lightboxStage" class="lightbox-stage">
      <img id="lightboxImg" class="lightbox-img" src="" alt="" onclick="event.stopPropagation(); toggleLightboxZoom();" />
    </div>
  </div>

  <script>
    let currentGroup = 'ALL';
    let sortColIndex = -1;
    let sortAscending = true;
    let originalRows = [];

    document.addEventListener("DOMContentLoaded", function() {
      const tbody = document.querySelector("#masterTable tbody");
      if (tbody) {
        originalRows = Array.from(tbody.querySelectorAll("tr"));
      }
    });

    // Close column dropdown when clicking outside
    window.addEventListener('click', function(e) {
      const dropdown = document.getElementById('colDropdown');
      if (dropdown && !e.target.closest('.dropdown')) {
        dropdown.classList.remove('show');
      }
    });

    function toggleDropdown(e) {
      e.stopPropagation();
      const dropdown = document.getElementById('colDropdown');
      if (dropdown) {
        dropdown.classList.toggle('show');
      }
    }

    function toggleColumn(colIndex, isVisible) {
      const table = document.getElementById("masterTable");
      if (!table) return;
      const th = table.querySelectorAll("thead th")[colIndex];
      if (th) th.style.display = isVisible ? "" : "none";
      table.querySelectorAll("tbody tr").forEach(tr => {
        const td = tr.children[colIndex];
        if (td) td.style.display = isVisible ? "" : "none";
      });
    }

    function setGroupFilter(group, btn) {
      currentGroup = group;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      filterTable();
    }

    function filterTable() {
      const q = (document.getElementById('speciesSearch').value || '').toLowerCase();
      document.querySelectorAll('#masterTable tbody tr').forEach(tr => {
        const grp = tr.getAttribute('data-group');
        const txt = tr.innerText.toLowerCase();
        const matchGrp = (currentGroup === 'ALL') || (grp === currentGroup);
        const matchTxt = !q || txt.includes(q);
        tr.style.display = (matchGrp && matchTxt) ? '' : 'none';
      });
      document.querySelectorAll('.species-card').forEach(card => {
        const grp = card.getAttribute('data-group');
        const txt = card.innerText.toLowerCase();
        const matchGrp = (currentGroup === 'ALL') || (grp === currentGroup);
        const matchTxt = !q || txt.includes(q);
        card.style.display = (matchGrp && matchTxt) ? '' : 'none';
      });
    }

    function sortTable(colIndex) {
      const table = document.getElementById("masterTable");
      if (!table) return;
      const tbody = table.querySelector("tbody");
      const rows = Array.from(tbody.querySelectorAll("tr"));

      if (sortColIndex === colIndex) {
        sortAscending = !sortAscending;
      } else {
        sortColIndex = colIndex;
        sortAscending = true;
      }

      rows.sort((a, b) => {
        const aCell = a.children[colIndex];
        const bCell = b.children[colIndex];
        const aVal = aCell ? aCell.innerText.trim() : "";
        const bVal = bCell ? bCell.innerText.trim() : "";

        // Parse numeric strings (stripping commas, percentages)
        const aNum = parseFloat(aVal.replace(/,/g, '').replace(/%/g, ''));
        const bNum = parseFloat(bVal.replace(/,/g, '').replace(/%/g, ''));

        if (!isNaN(aNum) && !isNaN(bNum)) {
          return sortAscending ? aNum - bNum : bNum - aNum;
        }
        return sortAscending ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
      });

      rows.forEach(r => tbody.appendChild(r));
      updateSortIndicators();
    }

    function updateSortIndicators() {
      const headers = document.querySelectorAll("#masterTable thead th");
      headers.forEach((th, idx) => {
        const icon = th.querySelector(".sort-icon");
        if (icon) {
          if (idx === sortColIndex) {
            icon.innerText = sortAscending ? "▲" : "▼";
            icon.style.color = "#0f172a";
          } else {
            icon.innerText = "⇅";
            icon.style.color = "#94a3b8";
          }
        }
      });
    }

    function resetTable() {
      // 1. Reset search text
      document.getElementById("speciesSearch").value = "";

      // 2. Reset group filter buttons
      currentGroup = 'ALL';
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      const allBtn = document.querySelector('.filter-btn');
      if (allBtn) allBtn.classList.add('active');

      // 3. Reset column visibility
      document.querySelectorAll('.col-toggle-checkbox').forEach(cb => {
        cb.checked = true;
        toggleColumn(parseInt(cb.value), true);
      });

      // 4. Reset sorting order to original
      sortColIndex = -1;
      sortAscending = true;
      const tbody = document.querySelector("#masterTable tbody");
      if (tbody && originalRows.length > 0) {
        originalRows.forEach(r => tbody.appendChild(r));
      }
      updateSortIndicators();

      // 5. Re-filter
      filterTable();
    }

    // Global Floating Tooltip System (avoids overflow/clipping inside tables and cards)
    const tooltipEl = document.getElementById('globalTooltip');
    let currentTooltipTarget = null;

    function positionTooltip(target) {
      if (!tooltipEl || !target) return;
      tooltipEl.style.left = '0px';
      tooltipEl.style.top = '0px';
      const rect = target.getBoundingClientRect();
      const tipWidth = tooltipEl.offsetWidth;
      const tipHeight = tooltipEl.offsetHeight;

      // Default: centered horizontally above element with 8px margin
      let top = rect.top - tipHeight - 8;
      let left = rect.left + (rect.width / 2) - (tipWidth / 2);

      // If overflowing viewport top, flip below the target
      if (top < 8) {
        top = rect.bottom + 8;
      }
      // If still overflowing viewport bottom, clamp
      if (top + tipHeight > window.innerHeight - 8) {
        top = Math.max(8, window.innerHeight - tipHeight - 8);
      }

      // Horizontal edge clamping
      if (left < 10) {
        left = 10;
      } else if (left + tipWidth > window.innerWidth - 10) {
        left = Math.max(10, window.innerWidth - tipWidth - 10);
      }

      tooltipEl.style.top = `${top}px`;
      tooltipEl.style.left = `${left}px`;
    }

    function showTooltip(target) {
      const text = target.getAttribute('data-tooltip');
      if (!text || !tooltipEl) return;
      currentTooltipTarget = target;
      tooltipEl.textContent = text;
      tooltipEl.classList.add('visible');
      positionTooltip(target);
    }

    function hideTooltip() {
      if (!tooltipEl) return;
      tooltipEl.classList.remove('visible');
      currentTooltipTarget = null;
    }

    document.addEventListener('mouseover', function(e) {
      const target = e.target.closest('[data-tooltip]');
      if (target) {
        showTooltip(target);
      }
    });

    document.addEventListener('mouseout', function(e) {
      const target = e.target.closest('[data-tooltip]');
      if (target) {
        if (e.relatedTarget && target.contains(e.relatedTarget)) {
          return;
        }
        hideTooltip();
      }
    });

    window.addEventListener('scroll', function() {
      if (currentTooltipTarget) {
        positionTooltip(currentTooltipTarget);
      }
    }, true);

    window.addEventListener('resize', function() {
      if (currentTooltipTarget) {
        positionTooltip(currentTooltipTarget);
      }
    });

    // Full-Screen Figure Lightbox Viewer
    const lightboxEl = document.getElementById('imageLightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxStage = document.getElementById('lightboxStage');
    const lightboxZoomBtn = document.getElementById('lightboxZoomBtn');

    function openImageLightbox(imgEl) {
      if (!lightboxEl || !lightboxImg || !imgEl) return;
      lightboxImg.src = imgEl.src;
      lightboxImg.alt = imgEl.alt || 'Diagnostic Figure';
      if (lightboxTitle) {
        lightboxTitle.textContent = imgEl.alt || 'Diagnostic Figure';
      }
      if (lightboxStage) {
        lightboxStage.classList.remove('zoomed');
      }
      if (lightboxZoomBtn) {
        lightboxZoomBtn.textContent = '🔍 Zoom 1:1 / Pan';
      }
      lightboxEl.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeImageLightbox() {
      if (!lightboxEl) return;
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
      lightboxEl.classList.remove('active');
      if (lightboxImg) lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    function toggleLightboxZoom() {
      if (!lightboxStage) return;
      const isZoomed = lightboxStage.classList.toggle('zoomed');
      if (lightboxZoomBtn) {
        lightboxZoomBtn.textContent = isZoomed ? '🗗 Fit to Screen' : '🔍 Zoom 1:1 / Pan';
      }
    }

    function toggleNativeFullscreen() {
      if (!lightboxEl) return;
      if (!document.fullscreenElement) {
        if (lightboxEl.requestFullscreen) {
          lightboxEl.requestFullscreen().catch(() => {});
        }
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    function handleLightboxBackdropClick(e) {
      if (e.target === lightboxEl || e.target === lightboxStage) {
        closeImageLightbox();
      }
    }

    document.addEventListener('keydown', function(e) {
      if (!lightboxEl || !lightboxEl.classList.contains('active')) return;
      if (e.key === 'Escape') {
        closeImageLightbox();
      } else if (e.key === 'f' || e.key === 'F') {
        toggleNativeFullscreen();
      } else if (e.key === 'z' || e.key === 'Z') {
        toggleLightboxZoom();
      }
    });
  </script>
</body>
</html>
