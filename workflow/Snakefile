# ============================================================================ #
# ValidateClassificationsSMK (v2) — High-Throughput eDNA Validation Pipeline
# ============================================================================ #
# SweBITS Project, Umeå University — Architected for HPC2N Kebnekaise (SLURM)
#
# WHY THIS WORKFLOW IS STRUCTURED AROUND A CHECKPOINT & STATUS LEDGER:
# When validating dozens or hundreds of putative eDNA detections across 516 weekly
# metagenomic samples, individual taxa may legitimately fail pre-flight checks
# (e.g., < 1,000 total reads across 10 years, organellar-only database representation,
# or highly fragmented draft assemblies with < 100 kb in >= 1 kb contigs).
#
# Instead of crashing Snakemake or forcing manual curation of `config/targets.tsv`,
# Stage 0 and Stage 1 evaluate all pre-flight and reference quality gates up front
# and emit a Snakemake checkpoint (`results/00_ledger/active_species.tsv`).
# Only species passing both Stage 0 and Stage 1 trigger heavy downstream compute
# (516-sample FASTQ extraction, 2.6 TB Kraken 2 streaming, CR binning, Minimap2
# alignment, and recursive OLS regression), while EVERY target species from
# `config/targets.tsv` is guaranteed to appear in `validation_master_summary.tsv`
# and `validation_report.html` with its explicit `validation_status` and `status_reason`.

from pathlib import Path
import csv
import os
import sys

configfile: "config/config.yaml"

# --- Resolve Core Directories --- #
WORKFLOW_DIR = Path(workflow.current_basedir)
PROJECT_ROOT = WORKFLOW_DIR.parent if WORKFLOW_DIR.name == "workflow" else WORKFLOW_DIR
SCRIPTS_DIR = WORKFLOW_DIR / "scripts"
ENVS_DIR = WORKFLOW_DIR / "envs"
RESULTS_DIR = Path("results")
LOGS_DIR = Path("logs")
BENCHMARKS_DIR = Path("benchmarks")

# --- Discover the 516 Metagenomic Samples from Classification Files --- #
SAMPLE_KRAKEN_PATTERN = config["sample_kraken_pattern"]
SAMPLES = sorted(set(glob_wildcards(SAMPLE_KRAKEN_PATTERN).sample))
if not SAMPLES:
    sys.exit(
        f"WORKFLOW_ERROR: No sample classification files found matching pattern '{SAMPLE_KRAKEN_PATTERN}'."
    )

# --- Dynamic SLURM Retry Resource Scaling Helpers --- #
# Why we scale mem_mb and runtime geometrically with `attempt` and input size:
# Eukaryotic genomes vary in size by > 2 orders of magnitude (10 Mb fungi to > 20 Gb
# conifers), and eDNA read counts per taxon span 10^3 to > 5x10^7 pairs.
# Combining an input-size heuristic on Attempt 1 with geometric retry scaling
# (`1.7^(attempt-1)` for memory, `1.5^(attempt-1)` for runtime across `retries: 5`)
# allows baseline jobs to schedule immediately on Kebnekaise while scaling up to
# > 33 GB / > 150 GB on retries if SLURM kills a job for OOM or TIMEOUT.
RES_CFG = config.get("resources", {})
DEFAULT_RETRIES = int(RES_CFG.get("default_retries", 5))
MEM_RETRY_BASE = float(RES_CFG.get("mem_retry_base", 1.7))
RUNTIME_RETRY_BASE = float(RES_CFG.get("runtime_retry_base", 1.5))


def get_threads(rule_key: str, default: int = 2) -> int:
    return int(RES_CFG.get(rule_key, {}).get("threads", default))


def scale_mem_mb(rule_key: str, default_mb: int = 4000, input_mb_mult: float = 0.0):
    base = int(RES_CFG.get(rule_key, {}).get("mem_mb", default_mb))

    def _mem(wildcards, attempt, input):
        est_mb = base
        if input_mb_mult > 0.0:
            try:
                est_mb = max(base, int(base / 2 + input.size_mb * input_mb_mult))
            except Exception:
                est_mb = base
        return int(round(est_mb * (MEM_RETRY_BASE ** (attempt - 1))))

    return _mem


_SAMPLE_READS_CACHE = None


def _get_sample_target_reads_map():
    """
    Lazily loads and caches the total Stage 0 target clade read pairs per (year, week)
    across all active species (`results/00_ledger/active_species.tsv`), allowing
    `extract_sample_clade_reads` to predict `seqtk subseq` + Python demux RAM usage
    with >99.9% accuracy before submitting the SLURM job.
    """
    global _SAMPLE_READS_CACHE
    if _SAMPLE_READS_CACHE is not None:
        return _SAMPLE_READS_CACHE

    active_path = Path("results/00_ledger/active_species.tsv")
    weekly_path = Path("results/01_inputs/raw_weekly_counts/raw_weekly_counts_long.tsv")
    if not active_path.is_file() or not weekly_path.is_file():
        return {}

    try:
        with open(active_path, "r", encoding="utf-8") as fh:
            active_tids = {row["t_id"] for row in csv.DictReader(fh, delimiter="\t") if row.get("t_id")}
        counts = {}
        with open(weekly_path, "r", encoding="utf-8") as fh:
            for row in csv.DictReader(fh, delimiter="\t"):
                if row.get("t_id") in active_tids:
                    key = (int(row["year"]), int(row["week"]))
                    counts[key] = counts.get(key, 0) + int(row["raw_kraken_reads"])
        _SAMPLE_READS_CACHE = counts
        return _SAMPLE_READS_CACHE
    except Exception:
        return {}


def scale_sample_extract_mem_mb(rule_key: str = "extract_sample_reads", default_mb: int = 4000):
    base = int(RES_CFG.get(rule_key, {}).get("mem_mb", default_mb))

    def _mem(wildcards, attempt):
        est_mb = base
        try:
            parts = str(wildcards.sample).split("_")
            yw = (int(parts[1]), int(parts[2]))
            sample_reads = _get_sample_target_reads_map().get(yw, 0)
            est_mb = max(base, int(2000 + 0.55 * (sample_reads / 1000.0)))
        except Exception:
            est_mb = base
        return int(round(est_mb * (MEM_RETRY_BASE ** (attempt - 1))))

    return _mem


def scale_runtime(rule_key: str, default_min: int = 30):
    base = int(RES_CFG.get(rule_key, {}).get("runtime_min", default_min))
    return lambda wildcards, attempt: f"{int(round(base * (RUNTIME_RETRY_BASE ** (attempt - 1))))}m"


# --- Checkpoint Helper Functions --- #
def get_active_species_records(wildcards=None):
    """
    Read `results/00_ledger/active_species.tsv` produced by `checkpoint filter_and_audit_assemblies`
    and return the list of dicts for all species that passed Stage 0 and Stage 1.
    """
    ckpt_output = checkpoints.filter_and_audit_assemblies.get().output.active_species
    records = []
    with open(ckpt_output, "r", encoding="utf-8") as fh:
        for row in csv.DictReader(fh, delimiter="\t"):
            if row.get("t_id"):
                records.append(row)
    return records


def get_active_taxids(wildcards=None):
    return [str(r["t_id"]) for r in get_active_species_records(wildcards)]


def get_active_species_map(wildcards=None):
    return {str(r["t_id"]): r for r in get_active_species_records(wildcards)}


def _fmt_pct_tag(frac: float) -> str:
    pct = round(float(frac) * 100.0, 4)
    if abs(pct - round(pct)) < 1e-6:
        return str(int(round(pct)))
    return f"{pct:g}".replace(".", "p")


def _fmt_scale_tag(val: float) -> str:
    return f"{float(val):g}".replace(".", "p")


def get_bin_param_tag() -> str:
    """
    Construct a deterministic, filesystem-safe parameter tag for Stage 3 binning outputs
    (e.g. `bins100_s0p3-1p7`) from `n_bins`, `bin_min_scale`, and `bin_max_scale`
    (or `bin_tag_override` if explicitly set). This keeps upstream Stages 0–2 shared
    while isolating binned CR references and metadata for each binning configuration.
    """
    override = str(config.get("bin_tag_override", "")).strip()
    if override:
        return override
    n_bins = int(config.get("n_bins", 100))
    min_s = _fmt_scale_tag(config.get("bin_min_scale", 0.3))
    max_s = _fmt_scale_tag(config.get("bin_max_scale", 1.7))
    return f"bins{n_bins}_s{min_s}-{max_s}"


def get_mapping_param_tag() -> str:
    """
    Construct a deterministic, filesystem-safe parameter tag for Stage 4 & Stage 5 mapping
    thresholds (e.g. `mapq30_aln80_id99`) from `min_mapq`, `min_align_frac`, and
    `max_mismatch_frac` (or `mapping_tag_override` if explicitly set).
    """
    override = str(config.get("mapping_tag_override", "")).strip()
    if override:
        return override
    min_mapq = int(config.get("min_mapq", 30))
    min_align_frac = float(config.get("min_align_frac", 0.80))
    max_mismatch_frac = float(config.get("max_mismatch_frac", 0.01))
    aln_str = _fmt_pct_tag(min_align_frac)
    id_str = _fmt_pct_tag(1.0 - max_mismatch_frac)
    return f"mapq{min_mapq}_aln{aln_str}_id{id_str}"


BIN_TAG = get_bin_param_tag()
MAP_TAG = get_mapping_param_tag()
RUN_TAG = f"{BIN_TAG}_{MAP_TAG}"


wildcard_constraints:
    t_id=r"[0-9]+",
    sample=r"Lj_[0-9]+_[0-9]+_[0-9]+",

localrules:
    all,
    workflow_start_info

rule all:
    default_target: True
    input:
        master_tsv = f"results/05_reports/{RUN_TAG}/validation_master_summary_{RUN_TAG}.tsv",
        master_parquet = f"results/05_reports/{RUN_TAG}/validation_master_summary_{RUN_TAG}.parquet",
        timeseries_parquet = f"results/05_reports/{RUN_TAG}/validated_timeseries_long_{RUN_TAG}.parquet",
        html_report = f"results/05_reports/{RUN_TAG}/validation_report_{RUN_TAG}.html",
        html_report_4panel = f"results/05_reports/{RUN_TAG}/validation_report_4panel_{RUN_TAG}.html",
        html_report_10panel = f"results/05_reports/{RUN_TAG}/validation_report_10panel_{RUN_TAG}.html",
        wf_info = "results/00_ledger/workflow_run_info.json"

